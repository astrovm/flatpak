{
  "app-id": "io.github.astrovm.Ventoy",
  "runtime": "org.gnome.Platform",
  "runtime-version": "50",
  "sdk": "org.gnome.Sdk",
  "command": "ventoy",
  "finish-args": [
    "--share=ipc",
    "--socket=x11",
    "--talk-name=org.freedesktop.Flatpak"
  ],
  "modules": [
    {
      "name": "ventoy",
      "buildsystem": "simple",
      "build-commands": [
        "install -Dm755 ventoy-launch.sh /app/bin/ventoy",
        "install -Dm644 io.github.astrovm.Ventoy.desktop /app/share/applications/io.github.astrovm.Ventoy.desktop",
        "install -Dm644 io.github.astrovm.Ventoy.metainfo.xml /app/share/metainfo/io.github.astrovm.Ventoy.metainfo.xml",
        "install -Dm644 io.github.astrovm.Ventoy.png /app/share/icons/hicolor/256x256/apps/io.github.astrovm.Ventoy.png",
        "install -d /app/ventoy",
        "cp -a upstream/. /app/ventoy/",
        "test -x /app/ventoy/VentoyGUI.x86_64 && test -x /app/ventoy/VentoyGUI.aarch64 && test -f /app/ventoy/tool/VentoyGTK.glade"
      ],
      "sources": [
        {
          "type": "file",
          "path": "../../scripts/ventoy-launch.sh"
        },
        {
          "type": "file",
          "path": "io.github.astrovm.Ventoy.desktop"
        },
        {
          "type": "file",
          "path": "io.github.astrovm.Ventoy.metainfo.xml"
        },
        {
          "type": "file",
          "path": "io.github.astrovm.Ventoy.png"
        },
        {
          "type": "archive",
          "url": "https://github.com/ventoy/Ventoy/releases/download/v1.1.18/ventoy-1.1.18-linux.tar.gz",
          "sha256": "d86ff9de63d94c8b8f1f6b14d23c55af4b88e8207bf2893890892a6a97b1ad54",
          "dest": "upstream",
          "strip-components": 2
        }
      ]
    }
  ]
}
