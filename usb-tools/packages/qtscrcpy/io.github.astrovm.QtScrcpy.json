{
  "app-id": "io.github.astrovm.QtScrcpy",
  "runtime": "org.gnome.Platform",
  "runtime-version": "50",
  "sdk": "org.gnome.Sdk",
  "command": "qtscrcpy",
  "finish-args": [
    "--share=ipc",
    "--share=network",
    "--socket=x11",
    "--device=all"
  ],
  "modules": [
    {
      "name": "qtscrcpy",
      "buildsystem": "simple",
      "build-commands": [
        "install -Dm755 qtscrcpy-launch.sh /app/bin/qtscrcpy",
        "install -Dm644 io.github.astrovm.QtScrcpy.desktop /app/share/applications/io.github.astrovm.QtScrcpy.desktop",
        "install -Dm644 io.github.astrovm.QtScrcpy.metainfo.xml /app/share/metainfo/io.github.astrovm.QtScrcpy.metainfo.xml",
        "install -Dm644 io.github.astrovm.QtScrcpy.png /app/share/icons/hicolor/256x256/apps/io.github.astrovm.QtScrcpy.png",
        "install -Dm644 LICENSE /app/share/licenses/qtscrcpy/LICENSE",
        "install -Dm644 NOTICE.adb /app/share/licenses/adb/NOTICE",
        "install -Dm755 adb-upstream/adb /app/bin/adb",
        "chmod +x QtScrcpy.AppImage",
        "./QtScrcpy.AppImage --appimage-extract",
        "install -d /app/qtscrcpy",
        "cp -a squashfs-root/usr/. /app/qtscrcpy/",
        "rm /app/qtscrcpy/bin/adb /app/qtscrcpy/lib/qtscrcpy/adb",
        "test -x /app/qtscrcpy/bin/QtScrcpy && test -f /app/qtscrcpy/lib/qtscrcpy/scrcpy-server"
      ],
      "sources": [
        {
          "type": "file",
          "path": "../../scripts/qtscrcpy-launch.sh"
        },
        {
          "type": "file",
          "path": "io.github.astrovm.QtScrcpy.desktop"
        },
        {
          "type": "file",
          "path": "io.github.astrovm.QtScrcpy.metainfo.xml"
        },
        {
          "type": "file",
          "path": "io.github.astrovm.QtScrcpy.png"
        },
        {
          "type": "file",
          "path": "LICENSE"
        },
        {
          "type": "file",
          "path": "NOTICE.adb"
        },
        {
          "type": "file",
          "url": "https://github.com/barry-ran/QtScrcpy/releases/download/v4.2.1/QtScrcpy-ubuntu-x64-v4.2.1.AppImage",
          "sha256": "bf2241273e41fae7532a7b046cbace936369f3bffc7fedbd7344bdc2fcebe485",
          "dest-filename": "QtScrcpy.AppImage"
        },
        {
          "type": "archive",
          "url": "https://github.com/Genymobile/scrcpy/releases/download/v5.0.1/scrcpy-linux-x86_64-v5.0.1.tar.gz",
          "sha256": "9f969d30cc574816077edecda65719c1c70b0aee1df1ba5fa00779ac07b8fd6e",
          "dest": "adb-upstream"
        }
      ]
    }
  ]
}
